{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copy Minified Files",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-Command",
        "if (-not (Test-Path ./js)) { New-Item -ItemType Directory -Path ./js }; $files = Get-ChildItem ./src -Recurse -Filter '*-min*'; if ($files.Count -eq 0) { Write-Host 'No files with -min found.' -ForegroundColor Red; exit 1; } else { foreach ($file in $files) { Copy-Item $file.FullName -Destination ./js } Write-Host 'Files copied.' -ForegroundColor Green; }"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
